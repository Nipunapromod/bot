# Meta WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-secret
META_APP_SECRET=

# AI and live web search
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
TAVILY_API_KEY=

# Private dashboard
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=

# Supabase (configure after choosing a dedicated project)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server
PORT=3000
NODE_ENV=production
WHATSAPP_GRAPH_VERSION=v23.0
USER_MESSAGES_PER_MINUTE=12
ALLOW_UNSIGNED_WEBHOOK=false
